---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { CONTACT } from "../config/theme.config.ts";
import footerBackground from "../assets/IMG_1884.JPG";

import orcid from "../assets/ORCID-iD_icon_vector.svg";
import github from "../assets/GitHub_Invertocat_White.svg";

const { flush = false } = Astro.props;
---

<footer class:list={[flush ? "mt-0" : "mt-24", "relative overflow-hidden"]}>

  <Image
    src={footerBackground}
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-center"
    width={1600}
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    format="webp"
    quality={50}
  />

  <div class="absolute inset-0 bg-black/35"></div>

  <div class="relative z-10 flex min-h-[300px] flex-col items-center justify-center px-5 py-16 text-center text-white">

    <div class="font-serif text-3xl font-semibold">
      {SITE.name}
    </div>

    <div class="mt-4 flex items-center gap-6">

  <a
    href={`mailto:${CONTACT.email}`}
    aria-label="Email"
    class="text-muted-foreground transition-opacity hover:opacity-70"
  >
    <Icon name="mail" class="h-10 w-10" />
  </a>

  <a
    href={CONTACT.orcid}
    aria-label="ORCID"
    target="_blank"
    rel="noopener noreferrer"
    class="transition-opacity hover:opacity-70"
  >
    <Image
      src={orcid}
      alt="ORCID"
      width={40}
      height={40}
    />
  </a>

  <a
    href={CONTACT.git}
    aria-label="GitHub"
    target="_blank"
    rel="noopener noreferrer"
    class="text-muted-foreground transition-opacity hover:opacity-70"
  >
    <Image
      src={github}
      alt="GitHub"
      width={40}
      height={40}
    />
  </a>

</div>
  </div>
</footer>
