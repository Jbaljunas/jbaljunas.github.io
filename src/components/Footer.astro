---
import { Image } from "astro:assets";
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { SOCIAL_LINKS } from "../config/theme.config.ts";
import footerBackground from "../assets/IMG_1884.JPG";

const { flush = false } = Astro.props;
---

<footer class:list={[flush ? "mt-0" : "mt-24", "relative overflow-hidden"]}>

  <Image
    src={footerBackground}
    alt=""
    class="absolute inset-0 h-full w-full object-cover object-center"
    width={1600}
    widths={[640, 960, 1280, 1600]}
    sizes="100vw"
    format="webp"
    quality={50}
  />

  <div class="absolute inset-0 bg-black/35"></div>

  <div class="relative z-10 flex min-h-[300px] flex-col items-center justify-center px-5 py-16 text-center text-white">

    <div class="font-serif text-3xl font-semibold">
      {SITE.name}
    </div>

    <div class="mt-6 flex items-center gap-6">
      {
        SOCIAL_LINKS.map((link) => (
          <a
            href={link.href}
            aria-label={link.label}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-opacity hover:opacity-70"
          >
            <Icon name={link.icon} class="h-6 w-6" />
          </a>
        ))
      }
    </div>

    <div class="mt-8 text-xs text-white/75">
      &copy; {new Date().getFullYear()} {SITE.name}
    </div>

  </div>
</footer>
