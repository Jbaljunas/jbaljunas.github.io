---
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { NAVIGATION } from "../config/theme.config.ts";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const isHome =
  current === "/" ||
  current === "/research";

const activeClass = isHome
  ? "home-header-link is-active"
  : "text-foreground";

const inactiveClass = isHome
  ? "home-header-link"
  : "text-muted-foreground transition-colors hover:text-foreground";

const headerClass = isHome
  ? "sticky top-0 z-40 border-b border-transparent bg-transparent text-white"
  : "sticky top-0 z-40 border-b border-border/60 bg-background/80 backdrop-blur-md";

const iconClass = isHome
  ? "home-header-action inline-flex h-9 w-9 items-center justify-center rounded-full transition-colors"
  : "inline-flex h-9 w-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground";

const { title, description, canonical, flushFooter = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title ? `${title} | ${SITE.name}` : SITE.name}</title>

    {description && (
      <meta name="description" content={description} />
    )}

    {canonical && (
      <link
        rel="canonical"
        href={`${Astro.site}${canonical}`}
      />
    )}

    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const systemDark =
        window.matchMedia("(prefers-color-scheme: dark)").matches;

      if (savedTheme === "dark" || (!savedTheme && systemDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body class="min-h-screen bg-background text-foreground antialiased">

    <header
      class={headerClass}
      data-home-header={isHome ? "true" : undefined}
      data-scrolled="false"
    >
      <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-5">

        <!-- Name -->
        <a href="/" class="flex items-center gap-2">
          <span
            class={`font-serif text-xl font-semibold ${
              isHome ? "home-header-brand" : ""
            }`}
          >
            {SITE.name}
          </span>
        </a>

        <!-- Navigation -->
        <nav
          class="hidden items-center gap-8 md:flex"
          aria-label="Primary navigation"
        >
          {
            NAVIGATION.map((item) => {
              const exact = item.to === "/";
              const active = exact
                ? current === "/"
                : current.startsWith(item.to);

              return (
                <a
                  href={item.to}
                  class={`text-sm ${
                    active ? activeClass : inactiveClass
                  }`}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <!-- Dark mode only -->
        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle dark mode"
          class={iconClass}
        >
          <span data-theme-icon="moon">
            <Icon name="moon" class="h-4 w-4" />
          </span>

          <span data-theme-icon="sun" hidden>
            <Icon name="sun" class="h-4 w-4" />
          </span>
        </button>

      </div>
    </header>

    <main>
      <slot />
    </main>

    <script>
      const themeToggle =
        document.querySelector("[data-theme-toggle]");

      const moonIcon =
        document.querySelector('[data-theme-icon="moon"]');

      const sunIcon =
        document.querySelector('[data-theme-icon="sun"]');

      const homeHeader =
        document.querySelector("[data-home-header]");

      const setThemeIcon = () => {
        const dark =
          document.documentElement.classList.contains("dark");

        if (moonIcon) moonIcon.hidden = dark;
        if (sunIcon) sunIcon.hidden = !dark;
      };

      setThemeIcon();

      themeToggle?.addEventListener("click", () => {
        const next =
          !document.documentElement.classList.contains("dark");

        document.documentElement.classList.toggle("dark", next);

        localStorage.setItem(
          "theme",
          next ? "dark" : "light"
        );

        setThemeIcon();
      });

      /*
       * Keep the original homepage scroll behavior.
       */
      const setHeaderScrolled = () => {
        if (!homeHeader) return;

        homeHeader.dataset.scrolled =
          window.scrollY > 8 ? "true" : "false";
      };

      setHeaderScrolled();

      window.addEventListener(
        "scroll",
        setHeaderScrolled,
        { passive: true }
      );
    </script>

  </body>
</html>
