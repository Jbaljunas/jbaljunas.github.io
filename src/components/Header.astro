---
import Icon from "./Icon.astro";
import { SITE } from "../lib/blog-data.js";
import { NAVIGATION } from "../config/theme.config.ts";

const current = Astro.url.pathname.replace(/\/$/, "") || "/";

const isTransparent =
  current === "/" ||
  current === "/research";

const activeClass = isTransparent
  ? "home-header-link is-active"
  : "text-foreground";

const inactiveClass = isTransparent
  ? "home-header-link"
  : "text-muted-foreground transition-colors hover:text-foreground";

const headerClass = isTransparent
  ? "absolute inset-x-0 top-0 z-40 border-b border-transparent bg-transparent text-white transition-all duration-300"
  : "sticky top-0 z-40 border-b border-border/60 bg-background/80 text-foreground backdrop-blur-md";

const iconClass = isTransparent
  ? "inline-flex h-9 w-9 items-center justify-center rounded-full text-white transition-colors hover:bg-white/10"
  : "inline-flex h-9 w-9 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground";

const { title, description, canonical, flushFooter = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title ? `${title} | ${SITE.name}` : SITE.name}</title>

    {description && (
      <meta name="description" content={description} />
    )}

    {canonical && (
      <link
        rel="canonical"
        href={`${Astro.site}${canonical}`}
      />
    )}

    <!-- Set dark mode before page renders -->
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const systemDark =
        window.matchMedia("(prefers-color-scheme: dark)").matches;

      if (savedTheme === "dark" || (!savedTheme && systemDark)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body class="min-h-screen bg-background text-foreground antialiased">

    <header
      class={headerClass}
      data-transparent={isTransparent ? "true" : "false"}
    >
      <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-5">

        <!-- Name -->
        <a href="/" class="flex items-center gap-2">
          <span class="font-serif text-xl font-semibold">
            {SITE.name}
          </span>
        </a>

        <!-- Navigation -->
        <nav
          class="flex items-center gap-8"
          aria-label="Primary navigation"
        >
          {
            NAVIGATION.map((item) => {
              const exact = item.to === "/";

              const active = exact
                ? current === "/"
                : current.startsWith(item.to);

              return (
                <a
                  href={item.to}
                  class={`header-link text-sm ${
                    active ? activeClass : inactiveClass
                  }`}
                  aria-current={active ? "page" : undefined}
                >
                  {item.label}
                </a>
              );
            })
          }
        </nav>

        <button
          type="button"
          data-theme-toggle
          aria-label="Toggle dark mode"
          class={iconClass}
        >
          <span data-theme-icon="moon">
            <Icon name="moon" class="h-4 w-4" />
          </span>

          <span data-theme-icon="sun" hidden>
            <Icon name="sun" class="h-4 w-4" />
          </span>
        </button>

      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- Dark mode + scrolling header -->
    <script>
      const themeToggle =
        document.querySelector("[data-theme-toggle]");

      const moonIcon =
        document.querySelector('[data-theme-icon="moon"]');

      const sunIcon =
        document.querySelector('[data-theme-icon="sun"]');

      const header =
        document.querySelector(
          "header[data-transparent='true']"
        );

      const links =
        header?.querySelectorAll(".header-link");

      /*
       * Update the moon/sun icon
       */
      const setThemeIcon = () => {
        const dark =
          document.documentElement.classList.contains("dark");

        if (moonIcon) moonIcon.hidden = dark;
        if (sunIcon) sunIcon.hidden = !dark;
      };

      setThemeIcon();

      /*
       * Dark mode toggle
       */
      themeToggle?.addEventListener("click", () => {
        const next =
          !document.documentElement.classList.contains("dark");

        document.documentElement.classList.toggle(
          "dark",
          next
        );

        localStorage.setItem(
          "theme",
          next ? "dark" : "light"
        );

        setThemeIcon();
      });

      /*
       * Change transparent header when scrolling
       */
      const updateHeader = () => {
        if (!header) return;

        const scrolled = window.scrollY > 50;

        if (scrolled) {

          // Header background
          header.classList.remove(
            "bg-transparent",
            "text-white",
            "border-transparent"
          );

          header.classList.add(
            "bg-background/80",
            "text-foreground",
            "border-border/60",
            "backdrop-blur-md"
          );

          // Navigation links
          links?.forEach((link) => {
            link.classList.remove(
              "home-header-link",
              "text-white"
            );

            link.classList.add(
              "text-muted-foreground",
              "hover:text-foreground"
            );
          });

          // Dark mode button
          themeToggle?.classList.remove("text-white");

          themeToggle?.classList.add(
            "text-muted-foreground"
          );

        } else {

          // Header background
          header.classList.remove(
            "bg-background/80",
            "text-foreground",
            "border-border/60",
            "backdrop-blur-md"
          );

          header.classList.add(
            "bg-transparent",
            "text-white",
            "border-transparent"
          );

          // Navigation links
          links?.forEach((link) => {
            link.classList.remove(
              "text-muted-foreground",
              "hover:text-foreground"
            );

            link.classList.add(
              "home-header-link"
            );
          });

          // Dark mode button
          themeToggle?.classList.remove(
            "text-muted-foreground"
          );

          themeToggle?.classList.add(
            "text-white"
          );
        }
      };

      updateHeader();

      window.addEventListener(
        "scroll",
        updateHeader,
        { passive: true }
      );
    </script>

  </body>
</html>
