---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import CV from "../documents/Baljunas_CV_2026.pdf";
---

<BaseLayout title="CV">

  <section class="relative min-h-[calc(100vh-4rem)] overflow-hidden">

    <div class="relative z-10 mx-auto max-w-5xl px-5 py-16">
      <iframe
        src={CV}
        class="h-[1000px] w-full border-0"
        title="Jenna Baljunas CV"
      ></iframe>
    </div>

  </section>

</BaseLayout>
